{% extends "base.jinja2" %}

{% block title %}
    <title>{{ content.display_name }} - DIAMM</title>
{% endblock %}

{% block head %}
    <meta name="description" content="{{ content.display_summary }}">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
    {% set source_structured_data = {
        "@context": "http://schema.org",
        "@type": "Thing",
        "url": request.build_absolute_uri(),
        "name": content.display_name,
        "description": content.display_summary,
    } %}
    <script type="application/ld+json">{{ source_structured_data|tojson }}</script>
    <script>
        document.addEventListener('alpine:init', () => {
            const tabsFromHash = () => {
                const hashPath = window.location.hash.split("?")[0];
                const hashParams = hashPath.replace(/^#/, '').split("/").filter(item => item);
                let selectedSourceTab = "description-tab";
                let selectedInventoryTab = "primary-inventory-tab";

                if (hashParams.length > 0) {
                    switch (hashParams[0])
                    {
                        {% if content.has_inventory %}
                            case "inventory":
                                selectedSourceTab = "inventory-tab";
                                switch (hashParams[1])
                                {
                                    case "composer":
                                        selectedInventoryTab = "composer-inventory-tab";
                                        break;
                                    case "alphabetical":
                                        selectedInventoryTab = "composition-inventory-tab";
                                        break;
                                }
                                break;
                        {% endif %}
                        {% if content.manifest_url %}
                            case "images":
                                selectedSourceTab = "images-tab";
                                break;
                        {% endif %}
                        {% if content.sets %}
                            case "sets":
                                selectedSourceTab = "sets-tab";
                                break;
                        {% endif %}
                        {% if content.bibliography %}
                        case "bibliography":
                            selectedSourceTab = "bibliography-tab";
                            break;
                        {% endif %}
                        case "commentary":
                            selectedSourceTab = "commentary-tab";
                            break;
                        {% if content.contributions %}
                        case "contributions":
                            selectedSourceTab = "contributions-tab";
                            break;
                        {% endif %}
                        {% if request.user.is_authenticated %}
                        case "corrections":
                            selectedSourceTab = "corrections-tab";
                            break;
                        {% endif %}
                    }
                }

                return { selectedSourceTab, selectedInventoryTab };
            };

            Alpine.data('sourceDetail', () => ({
                selectedSourceTab: "description-tab",
                selectedInventoryTab: "primary-inventory-tab",
                hashChangeHandler: null,
                inventoryUrl: "",
                inventoryHtml: "",
                inventoryLoaded: false,
                inventoryLoading: false,
                inventoryError: false,
                init() {
                    this.inventoryUrl = this.$root.dataset.inventoryUrl;
                    this.syncTabsFromHash();
                    this.hashChangeHandler = () => this.syncTabsFromHash();
                    window.addEventListener("hashchange", this.hashChangeHandler);
                },
                destroy() {
                    window.removeEventListener("hashchange", this.hashChangeHandler);
                },
                syncTabsFromHash() {
                    const tabs = tabsFromHash();
                    this.selectedSourceTab = tabs.selectedSourceTab;
                    this.selectedInventoryTab = tabs.selectedInventoryTab;
                    if (this.selectedSourceTab === "inventory-tab") {
                        this.loadInventory();
                    }
                },
                sourceTabIsSelected(tabName) {
                    return this.selectedSourceTab === tabName;
                },
                inventoryTabIsSelected(tabName) {
                    return this.selectedInventoryTab === tabName;
                },
                async loadInventory() {
                    if (this.inventoryLoaded || this.inventoryLoading) {
                        return;
                    }
                    this.inventoryLoading = true;
                    this.inventoryError = false;
                    try {
                        const response = await fetch(this.inventoryUrl, {
                            headers: {"Accept": "text/html"},
                        });
                        if (!response.ok) {
                            throw new Error(`Inventory request failed with ${response.status}`);
                        }
                        this.inventoryHtml = await response.text();
                        this.inventoryLoaded = true;
                    } catch (error) {
                        this.inventoryError = true;
                        console.error("Could not load the source inventory.", error);
                    } finally {
                        this.inventoryLoading = false;
                    }
                },
            }));
        })
    </script>
{% endblock %}

{% block body %}
<div x-data="sourceDetail"
     data-inventory-url="{{ url('source-inventory', pk=content.pk) }}">
    <div id="source-heading" class="columns">
        <div class="column is-two-thirds">
            <h2 class="title is-3">
                {{ content.display_name }}
                {% if content.is_virtual %}<span class="tag is-info is-large">Virtual</span>{% endif %}
            </h2>
            <h3 class="subtitle is-5" style="margin-bottom:0.5rem">
                <a href={{ content.archive.url }}>{{ content.archive.name }}</a>,
                <span>{{ content.archive.city }}, {{ content.archive.country }}</span>
            </h3>
            <h4 class="subtitle is-6">
                {% if content.source_type %}{{ content.source_type }}:{% endif %} {{ content.date_statement or '' }}</h4>
        </div>
        <div class="column source-archive-logo">
            <a href="{{ content.archive.url }}">
                <img src="{{ content.archive.logo }}" class="archive-header-logo"/>
            </a>
        </div>
    </div>
    <div class="columns">
        <div class="column">
            <div class="level">
                <div class="level-left is-fullwidth">
                    <div class="tabs">
                        <ul class="source-section-selector" role="tablist">
                            <li :class="sourceTabIsSelected($el.id) ? 'is-active' : ''"
                                id="description-tab">
                                <a href="#/">Description</a>
                            </li>
                            {% if content.has_inventory %}
                                <li id="inventory-tab"
                                    :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                    <a href="#/inventory">Inventory</a>
                                </li>
                            {% endif %}

                            {% if content.manifest_url %}
                                <li id="images-tab"
                                    :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                    {% if request.user.is_authenticated or content.has_external_manifest %}
                                        <a href="#/images">Images</a>
                                    {% else %}
                                        <a rel="nofollow" href="/login?next={{ request.path }}%23/images">Images (Log in to view)</a>
                                    {% endif %}
                                </li>
                            {% endif %}

                            {% if content.sets %}
                                <li id="sets-tab"
                                    :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                    <a href="#/sets">Sets</a>
                                </li>
                            {% endif %}

                            {% if content.bibliography %}
                                <li id="bibliography-tab"
                                    :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                    <a href="#/bibliography">Bibliography</a>
                                </li>
                            {% endif %}

                            <li id="commentary-tab"
                                :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                <a href="#/commentary">Commentary</a>
                            </li>
                            {% if content.contributions %}
                            <li id="contributions-tab"
                                :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                <a href="#/contributions">Contributions</a>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
                <div class="level-right">
                    <div class="tabs">
                        <ul>
                            {% if request.user.is_authenticated %}
                            <li id="corrections-tab"
                                :class="sourceTabIsSelected($el.id) ? 'is-active' : ''">
                                <a href="#/corrections">Contribute a Change</a>
                            </li>
                            {% endif %}

                            {% if request.user.is_staff %}
                            <li class="">
                                <a href="/admin/diamm_data/source/{{ content.pk }}">Edit</a>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div role="tabpanels">
        <section id="description-panel"
                 x-show="sourceTabIsSelected('description-tab')"
                 x-cloak
                 role="tabpanel">
            {% include "website/source/description.jinja2" %}
        </section>

        {% if content.has_inventory %}
            <section id="inventory-panel"
                     x-show="sourceTabIsSelected('inventory-tab')"
                     x-cloak
                     role="tabpanel">
                <div x-show="inventoryLoading" class="notification is-light">
                    Loading inventory…
                </div>
                <div x-show="inventoryError" class="notification is-danger">
                    <p>The inventory could not be loaded.</p>
                    <button type="button" class="button" @click="loadInventory()">
                        Try again
                    </button>
                </div>
                <div x-html="inventoryHtml"></div>
            </section>
        {% endif %}

        {% if content.manifest_url %}
            <section id="images-panel"
                     x-show="sourceTabIsSelected('images-tab')"
                     x-cloak
                     x-effect="if (sourceTabIsSelected('images-tab')) $nextTick(() => $dispatch('initialize-diva'))"
                     role="tabpanel">
                {% include "website/source/images.jinja2" %}
            </section>
        {% endif %}

        {% if content.sets %}
            <section id="sets-panel"
                     x-show="sourceTabIsSelected('sets-tab')"
                     x-cloak
                     role="tabpanel">
                {% include "website/source/sets.jinja2" %}
            </section>
        {% endif %}

        {% if content.bibliography %}
            <section id="bibliography"
                     x-show="sourceTabIsSelected('bibliography-tab')"
                     x-cloak
                     role="tabpanel">
                {% include "website/source/bibliography.jinja2" %}
            </section>
        {% endif %}

        <section id="commentary"
                 x-show="sourceTabIsSelected('commentary-tab')"
                 x-cloak
                 role="tabpanel">
            {% include "website/source/commentary.jinja2" %}
        </section>

        {% if content.contributions %}
        <section id="contributions"
                 x-show="sourceTabIsSelected('contributions-tab')"
                 x-cloak
                 role="tabpanel">
            {% include "website/source/contributions.jinja2" %}
        </section>
        {% endif %}

        {% if request.user.is_authenticated %}
        <section id="corrections"
                 x-show="sourceTabIsSelected('corrections-tab')"
                 x-cloak
                 role="tabpanel">
            {% include "website/source/corrections.jinja2" %}
        </section>
        {% endif %}

    </div>
</div>
{% endblock %}

{% block scripts %}
{% endblock %}
